# Build image for the Linux release artefacts.
#
# Debian 11 on purpose: it carries glibc 2.31, and a binary linked against
# 2.31 runs on everything newer. Building on the 22.04 workstation instead
# would pin the floor at glibc 2.35 and lock out Ubuntu 20.04, Debian 11 and
# the whole RHEL/Rocky/Alma 9 family, which is most of the corporate estate.
#
# Qt is compiled here rather than installed, because no distribution ships a
# Qt new enough on a base this old.
#
#   podman build -t vivora-build -f packaging/linux/Containerfile .
#
# The Qt stage takes a couple of hours; the image caches it, so rebuilding
# Vivora afterwards is a normal incremental build.

FROM docker.io/library/debian:11

ARG QT_VERSION=6.8.2
ARG CMAKE_VERSION=3.28.6
ARG JOBS=12

ENV DEBIAN_FRONTEND=noninteractive

# Toolchain, then the libraries Vivora links, then the ones Qt needs to
# produce a usable xcb/wayland platform plugin. A missing xcb dev package
# does not fail the Qt build -- it silently produces a Qt that cannot open a
# window, which is a much worse way to find out.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ninja-build pkg-config perl python3 git curl ca-certificates \
        file patchelf desktop-file-utils zsync \
        libavcodec-dev libavutil-dev libswscale-dev \
        libpipewire-0.3-dev libdbus-1-dev libpulse-dev \
        libwayland-dev wayland-protocols libwayland-egl-backend-dev \
        libgl-dev libegl-dev libglx-dev libopengl-dev libglu1-mesa-dev \
        libxkbcommon-dev libxkbcommon-x11-dev \
        libx11-dev libx11-xcb-dev libxext-dev libxfixes-dev libxi-dev libxrender-dev \
        libxcb1-dev libxcb-glx0-dev libxcb-keysyms1-dev libxcb-image0-dev \
        libxcb-shm0-dev libxcb-icccm4-dev libxcb-sync-dev libxcb-xfixes0-dev \
        libxcb-shape0-dev libxcb-randr0-dev libxcb-render-util0-dev \
        libxcb-util-dev libxcb-xinerama0-dev libxcb-xkb-dev libxcb-cursor-dev \
        libfontconfig1-dev libfreetype6-dev libglib2.0-dev libssl-dev zlib1g-dev \
        libva-dev libdrm-dev \
    && rm -rf /var/lib/apt/lists/*

# Bullseye has CMake 3.18; Qt 6.8 wants 3.21+.
RUN curl -fsSL "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz" \
      | tar xz -C /opt \
 && ln -s "/opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/cmake"  /usr/local/bin/cmake \
 && ln -s "/opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/ctest"  /usr/local/bin/ctest \
 && cmake --version

# OpenSSL 3, from source.
#
# Bullseye only has 1.1, and Qt binds to whichever major it was compiled
# against -- a Qt built against 1.1 reports supportsSsl=0 on every modern
# distribution, which means no update check, no announcements and no account
# sign-in, so no Pro on Linux at all.  1.1 also went end of life in September
# 2023, and unlike the Windows build (where TLS is Schannel and OpenSSL is
# never actually used) this one would carry real traffic.
#
# --openssldir=/etc/ssl so it reads the *host* CA store at runtime, which is
# where every distribution we target keeps one.
#
# Qt is then built with FEATURE_openssl_linked, so its TLS backend carries a
# real DT_NEEDED on these libraries instead of dlopening "libssl.so.3" by
# name at runtime.  Runtime resolution picks up whatever the host has: on
# Ubuntu 22.04 (OpenSSL 3.0) that happened to work, on Fedora 40 (3.2) the
# backend quietly failed to register and the app fell back to cert-only --
# no HTTPS, so no update check, no announcements and no account sign-in.
# Linking makes the loader resolve them from the AppImage every time.
ARG OPENSSL_VERSION=3.0.15
RUN mkdir -p /src \
 && curl -fsSL "https://github.com/openssl/openssl/releases/download/openssl-${OPENSSL_VERSION}/openssl-${OPENSSL_VERSION}.tar.gz" \
      | tar xz -C /src \
 && cd "/src/openssl-${OPENSSL_VERSION}" \
 && ./Configure linux-x86_64 shared --prefix=/opt/openssl --openssldir=/etc/ssl \
 && make -j${JOBS} >/dev/null \
 && make install_sw >/dev/null \
 && cd / && rm -rf "/src/openssl-${OPENSSL_VERSION}" \
 && echo /opt/openssl/lib64 > /etc/ld.so.conf.d/openssl3.conf && ldconfig \
 && /opt/openssl/bin/openssl version

# Qt, from the GitHub mirrors (code.qt.io is not always reachable). Only the
# three modules Vivora actually uses; qtbase alone is most of the build.
WORKDIR /src
RUN git clone -q --depth 1 --branch "v${QT_VERSION}" https://github.com/qt/qtbase.git \
 && git clone -q --depth 1 --branch "v${QT_VERSION}" https://github.com/qt/qtshadertools.git \
 && git clone -q --depth 1 --branch "v${QT_VERSION}" https://github.com/qt/qtdeclarative.git

# -no-feature-relocatable: the default writes an absolute prefix into the
# libraries, which is fine here because the AppImage rpath-patches them anyway.
RUN cmake -S qtbase -B build-qtbase -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/qt \
        -DQT_BUILD_EXAMPLES=OFF -DQT_BUILD_TESTS=OFF \
        -DFEATURE_xcb=ON -DFEATURE_xkbcommon=ON -DFEATURE_xkbcommon_x11=ON \
        -DFEATURE_opengl=ON -DFEATURE_egl=ON \
        -DOPENSSL_ROOT_DIR=/opt/openssl -DFEATURE_openssl=ON \
        -DFEATURE_openssl_linked=ON \
 && cmake --build build-qtbase --parallel ${JOBS} \
 && cmake --install build-qtbase \
 && rm -rf build-qtbase

# Fail loudly if the platform plugin did not get built: a Qt without xcb
# compiles Vivora perfectly and then cannot open a window at runtime.
RUN test -f /opt/qt/plugins/platforms/libqxcb.so \
    || (echo "FATAL: Qt built without the xcb platform plugin" && exit 1)
RUN test -f /opt/qt/plugins/tls/libqopensslbackend.so \
    || (echo "FATAL: Qt built without the OpenSSL TLS backend" && exit 1)

RUN cmake -S qtshadertools -B build-shader -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_PREFIX_PATH=/opt/qt \
        -DCMAKE_INSTALL_PREFIX=/opt/qt \
 && cmake --build build-shader --parallel ${JOBS} \
 && cmake --install build-shader \
 && rm -rf build-shader

RUN cmake -S qtdeclarative -B build-decl -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_PREFIX_PATH=/opt/qt \
        -DCMAKE_INSTALL_PREFIX=/opt/qt \
        -DQT_BUILD_EXAMPLES=OFF -DQT_BUILD_TESTS=OFF \
 && cmake --build build-decl --parallel ${JOBS} \
 && cmake --install build-decl \
 && rm -rf build-decl /src/qtbase /src/qtshadertools /src/qtdeclarative

# Make the Qt we just built the image's system Qt.  Setting LD_LIBRARY_PATH
# instead does not survive: linuxdeploy is itself an AppImage and its runtime
# sanitises the variable, so it reported "Could not find dependency:
# libQt6QuickControls2.so.6" and refused to deploy anything.
RUN echo /opt/qt/lib > /etc/ld.so.conf.d/qt6.conf && ldconfig

ENV CMAKE_PREFIX_PATH=/opt/qt
ENV PATH=/opt/qt/bin:$PATH
WORKDIR /work

# Debian 11 carries PipeWire 0.3.19, which predates SPA_PTROFF and the
# `command` callback in pw_stream_events -- src/host/capture/pipewire_capture.cpp
# does not compile against it.
#
# Vendor the 0.3.48 headers (the version this project builds against on Ubuntu
# 22.04) over the top, while still LINKING against Debian's library: every
# PipeWire function the capture code calls has existed since 0.3.0, so the link
# is satisfied, and a link error is exactly the signal we want if that ever
# stops being true.  At runtime it is the user's own libpipewire that gets
# loaded, because the AppImage deliberately does not bundle it.
#
# Appended after the Qt stages on purpose: putting it up with the other apt
# packages would invalidate the cached Qt build, which is two hours.
ARG PIPEWIRE_HEADERS=0.3.48
RUN git clone -q --depth 1 --branch ${PIPEWIRE_HEADERS} \
        https://github.com/PipeWire/pipewire.git /tmp/pw \
 && (cd /tmp/pw/src/pipewire && find . -name '*.h' -exec cp --parents {} /usr/include/pipewire-0.3/pipewire/ \;) \
 && (cd /tmp/pw/spa/include/spa && find . -name '*.h' -exec cp --parents {} /usr/include/spa-0.2/spa/ \;) \
 && rm -rf /tmp/pw \
 && grep -q SPA_PTROFF /usr/include/spa-0.2/spa/utils/defs.h
