# Generated by CMake into the build directory as artefact.env.
#
# Deliberately plain KEY=VALUE with no quoting so bash can `source` it and
# PowerShell can parse it with a two-line loop.  Packaging scripts read this
# rather than working the version out for themselves -- there is exactly one
# place a release name is decided, and it is project(VERSION) in CMakeLists.
VIVORA_VERSION=@PROJECT_VERSION@
VIVORA_VERSION_SUFFIX=@VIVORA_VERSION_SUFFIX@
VIVORA_PLATFORM_TAG=@VIVORA_PLATFORM_TAG@
VIVORA_ARTEFACT_BASENAME=@VIVORA_ARTEFACT_BASENAME@
VIVORA_BINDIR=@CMAKE_RUNTIME_OUTPUT_DIRECTORY@
