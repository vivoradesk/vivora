# Specify filepatterns you want git to ignore.
build/
build2/
build-linux/
*.log
# Generated test license artefacts (do NOT commit secrets to the repo)
license.sk
license.pk
token.bin

# FFmpeg distribution binaries — too large for GitHub (>100MB each)
# and not used by our build.  Contributors download them separately
# into third_party/ff/ for ad-hoc tests (see "Play with: ffplay ..."
# log hints in encode_test.cpp / transport_test.cpp).
third_party/ff/*.exe

# Claude Code local state — personal permissions + scheduler lock.
.claude/settings.local.json
.claude/scheduled_tasks.lock
