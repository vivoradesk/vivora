[Unit]
Description=Vivora media relay (UDP forwarder)
Documentation=https://github.com/vivoradesk/vivora
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Pro-managed mode: reject BINDs without a valid Ed25519 license token
# verified against the public key at /etc/vivora/license.pk.  The
# deploy script ensures that file is in place before starting the unit.
# Self-host operators can drop --require-license from this line and put
# the path back to /usr/local/bin/vivora-relay --port 7100.
ExecStart=/usr/local/bin/vivora-relay --port 7100 --require-license /etc/vivora/license.pk
Restart=on-failure
RestartSec=2
# Same dedicated unprivileged user the rendezvous unit creates.
User=vivora
Group=vivora

# Lockdown — same shape as vivora-rendezvous.service.  The relay
# touches a UDP socket and that's it; everything else is denied.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

# Resource caps — the relay holds in-memory bindings only, no buffers
# beyond the per-packet receive size.  256 MiB hard cap leaves room
# for hundreds of paired sessions.
MemoryHigh=128M
MemoryMax=256M
TasksMax=32

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vivora-relay

[Install]
WantedBy=multi-user.target
