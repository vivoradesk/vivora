[Unit]
Description=Vivora media relay (UDP forwarder)
Documentation=https://github.com/vivoradesk/vivora
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Open relay: anyone who can reach the port and knows a session id may
# bind.  That is the right default for a relay you run for yourself or
# your team -- reachability is controlled by the firewall, not by tokens.
# To gate access instead, mint a keypair and add:
#     --require-license /etc/vivora/license.pk
ExecStart=/usr/local/bin/vivora-relay --port 7100
Restart=on-failure
RestartSec=2
# Same dedicated unprivileged user the rendezvous unit creates.
User=vivora
Group=vivora

# Lockdown — same shape as vivora-rendezvous.service.  The relay
# touches a UDP socket and that's it; everything else is denied.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

# Resource caps — the relay holds in-memory bindings only, no buffers
# beyond the per-packet receive size.  256 MiB hard cap leaves room
# for hundreds of paired sessions.
MemoryHigh=128M
MemoryMax=256M
TasksMax=32

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vivora-relay

[Install]
WantedBy=multi-user.target
